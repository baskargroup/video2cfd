# --- Pipeline data (large; not tracked) ---
data/*
!data/README.md

# Verification scratch (local only)
.verify/

# Pipeline run outputs / caches
runs/
results/
*.ply
*.npy
scene_log*.json

# --- Downstream CFD (cfd/): generated cases and large artifacts ---
# Generated cases normally live under runs/ (ignored above). The patterns below
# also cover a case that was generated somewhere else in the working tree.
processor*/
postProcessing/
log.*
status/
*.foam
stl_watertight_report.json
# Container images and downloaded archives
*.sif
*.sif.sha256
*.tar.gz
*.zip
# SLURM job logs of cfd/scripts/*.slurm (written to the submit directory)
video2cfd_*.out
video2cfd_*.err

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
