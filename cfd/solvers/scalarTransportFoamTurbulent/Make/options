/*
 * Modified from applications/solvers/basic/scalarTransportFoam/Make/options
 * (OpenFOAM v2412) for the video2cfd project.
 *
 * The three turbulence/transport libraries at the end of EXE_LIBS are not
 * needed to resolve symbols. They are linked so that the wall-function
 * boundary condition types stored in the nut field written by the flow
 * solver (for example nutkWallFunction, which lives in libturbulenceModels)
 * are registered when the solver reads that field. Do not remove them.
 */

EXE_INC = \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/sampling/lnInclude

EXE_LIBS = \
    -lfiniteVolume \
    -lfvOptions \
    -lmeshTools \
    -lsampling \
    -lturbulenceModels \
    -lincompressibleTurbulenceModels \
    -lincompressibleTransportModels
